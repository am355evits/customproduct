<script>/* Daycare label personalizer — shared engine.
   ASSET_BASE is set by the page: a Shopify asset_url prefix, or "" when the
   images and fonts are embedded as data URLs.                                 */
(function () {
  const D = window.DAYCARE_DATA;
  const root = document.getElementById(D.rootId);
  if (!root || !D) return;

  const url = f => (D.assets && D.assets[f]) ? D.assets[f] : (D.base + f);
  const $ = s => root.querySelector(s) || document.querySelector(s);
  const $$ = s => [...root.querySelectorAll(s)];

  const COLORS = D.colors;
  const LW = D.labelW, LH = D.labelH;
  const R = 0.0867 / LH;                        // corner radius as a fraction

  const LAYOUT = {
    iconX: 0.035, iconW: 0.360, iconH: 0.850,
    gap: 0.030, right: 0.965, y: 0.120, h: 0.760, lh: 1.00, maxLines: 2
  };

  const state = {
    theme: D.lockedTheme || null,
    bg: D.backgrounds[10] ? D.backgrounds[10].id : D.backgrounds[0].id,
    icon: null, font: D.fonts[0].family,
    color: COLORS[0][1], colorName: COLORS[0][0], name: ""
  };

  const imgs = {};
  const pending = {};
  function need(key, src) {
    if (imgs[key]) return Promise.resolve();
    if (!pending[key]) pending[key] = loadImage(key, src);
    return pending[key];
  }
  async function needCurrent() {
    const b = bgById(state.bg), i = icById(state.icon);
    await Promise.all([
      b ? need("b:" + b.id, url(b.file)) : null,
      i ? need("i:" + i.id, url(i.file)) : null
    ].filter(Boolean));
  }
  const themes = [...new Set(D.icons.map(i => i.theme))];
  if (!state.theme) state.theme = themes[0];
  state.icon = D.icons.filter(i => i.theme === state.theme)[0].id;

  const bgById = id => D.backgrounds.find(b => b.id === id);
  const icById = id => D.icons.find(i => i.id === id);

  /* ---------- assets ---------- */
  function loadImage(key, src) {
    return new Promise(res => {
      const im = new Image();
      im.crossOrigin = "anonymous";
      im.onload = im.onerror = () => { imgs[key] = im; res(); };
      im.src = src;
    });
  }
  async function loadFonts() {
    await Promise.all(D.fonts.map(async f => {
      try {
        const face = new FontFace(f.family, `url(${url(f.file)}) format("woff")`);
        await face.load(); document.fonts.add(face);
      } catch (e) { /* that family will fall back */ }
    }));
  }

  /* ---------- shared layout math (used by canvas draw + SVG build) ---------- */
  function computeIconBox(W, H) {
    const ic = icById(state.icon);
    let right = LAYOUT.iconX, box = null;
    if (ic) {
      const bw = LAYOUT.iconW * W, bh = LAYOUT.iconH * H;
      const by = (H - bh) / 2;
      const k = Math.min(bw / ic.w, bh / ic.h);
      const w = ic.w * k, h = ic.h * k;
      const x = LAYOUT.iconX * W + (bw - w) / 2, y = by + (bh - h) / 2;
      right = (x + w) / W;
      box = { x, y, w, h };
    }
    return { right, box };
  }

  function computeTextLayout(ctx, W, H, right) {
    const raw = String(state.name || "");
    if (!raw.trim()) return null;
    const left = Math.min(right + LAYOUT.gap, LAYOUT.right - 0.08);
    const box = { x: left * W, y: LAYOUT.y * H, w: (LAYOUT.right - left) * W, h: LAYOUT.h * H };
    const setF = px => { ctx.font = `${px}px "${state.font}", sans-serif`; };
    const wOf = (t, px) => { setF(px); return ctx.measureText(t).width; };
    const explicit = raw.split(/\r?\n/).map(s => s.trim()).filter(Boolean);
    const linesAt = px => explicit.length > 1 ? explicit
      : wrap(explicit[0], box.w, t => wOf(t, px), LAYOUT.maxLines);
    const fits = px => {
      const l = linesAt(px);
      return px * LAYOUT.lh * l.length <= box.h && l.every(t => wOf(t, px) <= box.w);
    };
    let lo = 1, hi = H * 2.5;
    for (let i = 0; i < 38; i++) { const m = (lo + hi) / 2; if (fits(m)) lo = m; else hi = m; }
    const px = lo;
    setF(px);
    const lines = linesAt(px);
    const m0 = ctx.measureText(lines[0]), mN = ctx.measureText(lines[lines.length - 1]);
    const asc = m0.actualBoundingBoxAscent || px * 0.72;
    const desc = mN.actualBoundingBoxDescent || px * 0.24;
    const step = px * LAYOUT.lh;
    const blockH = asc + desc + step * (lines.length - 1);
    let base = box.y + (box.h - blockH) / 2 + asc;
    const linePos = lines.map(t => { const y = base; base += step; return { t, y }; });
    return { box, px, lines: linePos, over: !fits(px) };
  }

  function wrap(text, maxW, measure, maxLines) {
    const w = text.split(/\s+/).filter(Boolean);
    if (!w.length) return [text];
    const out = []; let cur = w[0];
    for (let i = 1; i < w.length; i++) {
      const t = cur + " " + w[i];
      if (measure(t) <= maxW || out.length + 1 >= maxLines) cur = t;
      else { out.push(cur); cur = w[i]; }
    }
    out.push(cur); return out;
  }

  /* ---------- drawing (canvas / PNG) ---------- */
  function draw(canvas, dpi) {
    const W = Math.round(LW * dpi), H = Math.round(LH * dpi);
    canvas.width = W; canvas.height = H;
    const ctx = canvas.getContext("2d");
    ctx.clearRect(0, 0, W, H);
    ctx.imageSmoothingQuality = "high";

    const bgi = imgs["b:" + state.bg];
    if (bgi && bgi.complete) ctx.drawImage(bgi, 0, 0, W, H);

    const { right, box: iconBox } = computeIconBox(W, H);
    if (iconBox) {
      const im = imgs["i:" + state.icon];
      if (im && im.complete) ctx.drawImage(im, iconBox.x, iconBox.y, iconBox.w, iconBox.h);
    }

    const tl = computeTextLayout(ctx, W, H, right);
    if (!tl) return { size: 0, lines: 0, over: false };

    ctx.fillStyle = state.color;
    ctx.textBaseline = "alphabetic";
    ctx.textAlign = "center";
    ctx.font = `${tl.px}px "${state.font}", sans-serif`;
    tl.lines.forEach(({ t, y }) => ctx.fillText(t, tl.box.x + tl.box.w / 2, y));
    return { size: tl.px, lines: tl.lines.length, over: tl.over };
  }

  /* ---------- PRINT FILE: ek hi SVG, text outlines me ----------
     Naam ka niyam (Content > Files me upload karo):
       icon        ANIMAL-1 -> print_ANIMAL_1.png   (DINOSAURS, DOLPHIN, SPACE, SPORT bhi aise hi)
       background  bg01     -> print_LABEL_1.svg    (bg02 -> print_LABEL_2.svg ... bg34 -> print_LABEL_34.svg)
     Shopify upload me spaces ko "_" bana deta hai, par dono naam try hote hain.
     Jo print_ file na mile, uski jagah preview image use hoti hai.
     Text ko paths me badalne ke liye opentype.js ek baar CDN se load hota hai;
     agar wo load na ho to text live <text> + embedded font ke roop me jata hai. */
  const PW = 1800, PH = 600;     // SVG ke andar ki units (design ka ratio 3:1)
  const OPENTYPE_URL = "https://cdn.jsdelivr.net/npm/opentype.js@1.3.4/dist/opentype.min.js";

  const printNames = {
    i: id => {
      const u = "print_" + id.replace("-", "_");
      const sp = "print_" + id.replace("-", "%20");
      return [u + ".png", sp + ".png", u + ".webp"];
    },
    b: id => {
      const n = parseInt(id.replace(/\D+/g, ""), 10);
      const u = "print_LABEL_" + n;
      return [u + ".svg", u + ".png", u + ".webp"];
    }
  };

  function escapeXML(s) {
    return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;")
      .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }
  function blobToDataURL(blob) {
    return new Promise((resolve, reject) => {
      const r = new FileReader();
      r.onload = () => resolve(r.result);
      r.onerror = reject;
      r.readAsDataURL(blob);
    });
  }

  const assets = {};   // "b:id" / "i:id" -> { svg | data, name } ya null
  async function getAsset(key, files) {
    if (key in assets) return assets[key];
    for (const f of files) {
      try {
        const r = await fetch(url(f));
        if (!r.ok) continue;
        assets[key] = /\.svg$/i.test(f)
          ? { svg: await r.text(), name: f }
          : { data: await blobToDataURL(await r.blob()), name: f };
        return assets[key];
      } catch (e) { /* agli file try karo */ }
    }
    assets[key] = null;
    return null;
  }
  const hrefOf = a => a.data || ("data:image/svg+xml;charset=utf-8," + encodeURIComponent(a.svg));

  // background SVG ko seedha print SVG ke andar daalta hai (vector hi rehta hai)
  function inlineSVG(text, W, H) {
    try {
      const doc = new DOMParser().parseFromString(text, "image/svg+xml");
      const svg = doc.documentElement;
      if (!svg || svg.nodeName.toLowerCase() !== "svg" || doc.querySelector("parsererror")) return null;
      svg.querySelectorAll("script,foreignObject").forEach(n => n.remove());
      let vb = svg.getAttribute("viewBox");
      if (!vb) {
        const w = parseFloat(svg.getAttribute("width")), h = parseFloat(svg.getAttribute("height"));
        if (!w || !h) return null;
        vb = "0 0 " + w + " " + h;
      }
      const ser = new XMLSerializer();
      const inner = [...svg.childNodes].map(n => ser.serializeToString(n)).join("");
      return `<svg x="0" y="0" width="${W}" height="${H}" viewBox="${vb}" preserveAspectRatio="none">${inner}</svg>`;
    } catch (e) { return null; }
  }

  let otPromise = null;
  function loadOpentype() {
    if (window.opentype) return Promise.resolve(window.opentype);
    if (!otPromise) otPromise = new Promise(res => {
      const sc = document.createElement("script");
      sc.src = OPENTYPE_URL;
      sc.onload = () => res(window.opentype || null);
      sc.onerror = () => res(null);
      document.head.appendChild(sc);
    });
    return otPromise;
  }
  const otFonts = {};
  async function getOtFont(family, ot) {
    if (family in otFonts) return otFonts[family];
    const f = D.fonts.find(x => x.family === family);
    try {
      const buf = await (await fetch(url(f.file))).arrayBuffer();
      otFonts[family] = ot.parse(buf);
    } catch (e) { otFonts[family] = null; }
    return otFonts[family];
  }
  async function fontDataURL(family) {
    const f = D.fonts.find(x => x.family === family);
    try { return await blobToDataURL(await (await fetch(url(f.file))).blob()); }
    catch (e) { return null; }
  }

  async function buildPrintSVG() {
    const b = bgById(state.bg), ic = icById(state.icon);
    const bgA = await getAsset("b:" + b.id, printNames.b(b.id).concat(b.file));
    const icA = ic ? await getAsset("i:" + ic.id, printNames.i(ic.id).concat(ic.file)) : null;
    console.info("dc print:", "bg ->", bgA ? bgA.name : "(rang)", "| icon ->", icA ? icA.name : "-");

    const measCtx = document.createElement("canvas").getContext("2d");
    const { right, box: iconBox } = computeIconBox(PW, PH);
    const tl = computeTextLayout(measCtx, PW, PH, right);

    let bgEl;
    if (bgA && bgA.svg) {
      bgEl = inlineSVG(bgA.svg, PW, PH)
        || `<image href="${hrefOf(bgA)}" xlink:href="${hrefOf(bgA)}" x="0" y="0" width="${PW}" height="${PH}" preserveAspectRatio="none"/>`;
    } else if (bgA) {
      bgEl = `<image href="${bgA.data}" xlink:href="${bgA.data}" x="0" y="0" width="${PW}" height="${PH}" preserveAspectRatio="none"/>`;
    } else {
      bgEl = `<rect x="0" y="0" width="${PW}" height="${PH}" fill="${b.dom || "#ffffff"}"/>`;
    }

    const icEl = (icA && iconBox)
      ? `<image href="${hrefOf(icA)}" xlink:href="${hrefOf(icA)}" x="${iconBox.x.toFixed(2)}" y="${iconBox.y.toFixed(2)}" width="${iconBox.w.toFixed(2)}" height="${iconBox.h.toFixed(2)}" preserveAspectRatio="xMidYMid meet"/>`
      : "";

    let defs = "", textEl = "";
    if (tl) {
      const cx = tl.box.x + tl.box.w / 2;
      const ot = await loadOpentype();
      const font = ot ? await getOtFont(state.font, ot) : null;
      if (font) {
        textEl = tl.lines.map(({ t, y }) => {
          const w = font.getAdvanceWidth(t, tl.px);
          return `<path d="${font.getPath(t, cx - w / 2, y, tl.px).toPathData(2)}" fill="${state.color}"/>`;
        }).join("");
      } else {
        const fd = await fontDataURL(state.font);
        if (fd) defs = `<defs><style>@font-face{font-family:"${escapeXML(state.font)}";src:url(${fd}) format("woff");}</style></defs>`;
        textEl = tl.lines.map(({ t, y }) =>
          `<text x="${cx.toFixed(2)}" y="${y.toFixed(2)}" font-family="${escapeXML(state.font)}, sans-serif" font-size="${tl.px.toFixed(2)}" fill="${state.color}" text-anchor="middle">${escapeXML(t)}</text>`
        ).join("");
      }
    }

    return `<?xml version="1.0" encoding="UTF-8"?>\n` +
      `<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="${LW}in" height="${LH}in" viewBox="0 0 ${PW} ${PH}">` +
      `<title>Label ${escapeXML(state.name.replace(/\s+/g, " ").trim())}</title>` +
      defs + bgEl + icEl + textEl + `</svg>`;
  }

  let printTimer = null, printSeq = 0;
  function attachPrintFile() {
    clearTimeout(printTimer);
    printTimer = setTimeout(async () => {
      const input = document.querySelector('[data-prop-file="Print"]');
      if (!input) return;
      const seq = ++printSeq;
      try {
        const svg = await buildPrintSVG();
        if (seq !== printSeq) return;               // beech me design badal gaya
        const file = new File([svg], "label-PRINT.svg", { type: "image/svg+xml" });
        const dt = new DataTransfer();
        dt.items.add(file);
        input.files = dt.files;
      } catch (e) { console.error("print file error:", e); }
    }, 400);   // har keystroke par heavy build na ho
  }

  /* ---------- interface ---------- */
  function paintSwatches() {
    $("[data-dc=bgs]").innerHTML = D.backgrounds.map(b =>
      `<button type="button" class="dc-sw" data-id="${b.id}" title="${b.label}"
        aria-pressed="${b.id === state.bg}"><img src="${url(b.file)}" alt="${b.label}" loading="lazy"></button>`).join("");
    $$("[data-dc=bgs] button").forEach(el => el.onclick = () => {
      state.bg = el.dataset.id; paintSwatches(); update();
    });
    $("[data-dc=bgname]").textContent = (bgById(state.bg) || {}).label || "";

    const pool = D.icons.filter(i => i.theme === state.theme);
    $("[data-dc=icons]").innerHTML = pool.map(i =>
      `<button type="button" class="dc-ic" data-id="${i.id}" title="${i.label}"
        aria-pressed="${i.id === state.icon}"><img src="${url(i.file)}" alt="${i.label}" loading="lazy"></button>`).join("");
    $$("[data-dc=icons] button").forEach(el => el.onclick = () => {
      state.icon = el.dataset.id; paintSwatches(); update();
    });

    const sample = (state.name.split(/\r?\n/)[0] || "").trim() || D.sampleName;
    $("[data-dc=fonts]").innerHTML = D.fonts.map(f =>
      `<button type="button" class="dc-fo" data-f="${f.family}" aria-pressed="${f.family === state.font}"
        style="font-family:'${f.family}',sans-serif">${sample.replace(/[<&]/g, "")}</button>`).join("");
    $$("[data-dc=fonts] button").forEach(el => el.onclick = () => {
      state.font = el.dataset.f; paintSwatches(); update();
    });
    $("[data-dc=fontname]").textContent = state.font;

    $("[data-dc=colors]").innerHTML = COLORS.map(([n, h]) =>
      `<button type="button" class="dc-dot" data-h="${h}" data-n="${n}" title="${n}" aria-label="${n}"
        style="background:${h}" aria-pressed="${h === state.color}"></button>`).join("");
    $$("[data-dc=colors] button").forEach(el => el.onclick = () => {
      state.color = el.dataset.h; state.colorName = el.dataset.n; paintSwatches(); update();
    });
    $("[data-dc=colorname]").textContent = state.colorName;

    if (D.lockedTheme) { const t = $("[data-dc=themes]"); if (t) t.style.display = "none"; }
    else {
      $("[data-dc=themes]").innerHTML = themes.map(t =>
        `<button type="button" class="dc-th" data-t="${t}" aria-pressed="${t === state.theme}">${t}</button>`).join("");
      $$("[data-dc=themes] button").forEach(el => el.onclick = () => {
        state.theme = el.dataset.t;
        state.icon = D.icons.filter(i => i.theme === state.theme)[0].id;
        paintSwatches(); update();
      });
    }
  }

  async function update() {
    await needCurrent();
    const canvas = $("[data-dc=canvas]");
    const r = draw(canvas, 300);
    $("[data-dc=warn]").textContent = r.over
      ? "That name is a little long for this label. Try a shorter one."
      : "";
    const set = (k, v) => { const el = document.querySelector(`[data-prop="${k}"]`); if (el) el.value = v; };
    const ic = icById(state.icon) || {};
    set("Design", state.theme || "");
    set("Background", (bgById(state.bg) || {}).label || "");
    set("Icon", (ic.theme || "") + " " + (ic.label || "").replace(/\D+/g, ""));
    set("Font", state.font);
    set("Text color", state.colorName);
    set("Name", state.name);
    set("_spec", [state.bg, state.icon, state.font, state.color].join("|"));

    // canvas ka PNG screenshot file input me daalein
    const fileInput = document.querySelector('[data-prop-file="Preview"]');
    if (fileInput && canvas.width && canvas.height) {
      try {
        canvas.toBlob(blob => {
          if (!blob) { console.warn("dc-preview: blob null, canvas tainted ho sakta hai"); return; }
          const file = new File([blob], "label-preview.png", { type: "image/png" });
          const dt = new DataTransfer();
          dt.items.add(file);
          fileInput.files = dt.files;
        }, "image/png");
      } catch (err) {
        console.error("dc-preview toBlob error:", err);
      }
    }

    // print SVG (high-res originals + text outlines)
    attachPrintFile();
  }

  /* ---------- the cart form ---------- */
  // Themes such as Dawn re-render the product form when the variant changes, so
  // the hidden inputs are put back whenever that happens.
  function attachToForm() {
    const holder = document.querySelector("[data-dc=props]");
    if (!holder) return;
    const form = document.querySelector('form[data-type="add-to-cart-form"]')
              || document.querySelector('form[action*="/cart/add"]:not([id*="installment"])');
    if (form && !form.contains(holder)) form.appendChild(holder);
  }
  function watchForm() {
    attachToForm();
    const target = document.querySelector("product-info, .product, main") || document.body;
    new MutationObserver(() => attachToForm()).observe(target, { childList: true, subtree: true });
    document.addEventListener("change", attachToForm, true);
  }
  (function moveMedia() {
    const preview = root.querySelector(".dc-preview");
    const wrapper = document.querySelector(".product__media-wrapper");
    if (!preview || !wrapper) return;
    const gallery = wrapper.querySelector("media-gallery");
    if (gallery) gallery.style.display = "none";
    wrapper.appendChild(preview);
  })();

  /* ---------- go ---------- */
  (async function () {
    const nameEl = $("[data-dc=name]");
    nameEl.addEventListener("input", e => {
      state.name = e.target.value;
      $("[data-dc=count]").textContent = state.name.length + " / 100";
      paintSwatches(); update();
    });
    paintSwatches();
    watchForm();
    await needCurrent();
    update();
    root.classList.add("dc-ready");
    await loadFonts();
    if (document.fonts) await document.fonts.ready;
    paintSwatches();
    update();
    // the rest arrive quietly once the page is settled
    const rest = () => {
      D.icons.filter(i => i.theme === state.theme).forEach(i => need("i:" + i.id, url(i.file)));
      D.backgrounds.forEach(b => need("b:" + b.id, url(b.file)));
      D.icons.forEach(i => need("i:" + i.id, url(i.file)));
    };
    if (window.requestIdleCallback) requestIdleCallback(rest, { timeout: 3000 });
    else setTimeout(rest, 1200);
  })();
})();
</script>